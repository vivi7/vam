device=surfaceduo
soc=sd855
gpu=adreno640
ram_gb=6
sdk_allow=32
build_allow=2022.902.48
lens_policy=all
accel_backend=gpu_gl
fps_target=20
fps_floor=15
rss_budget_mb=350
thermal_ladder=38:detect_rada,40:roi_128,42:480p,44:passthrough
ring_path=/data/local/tmp/camswap_ring.shm
model_dir=/data/adb/modules/camswap/system/etc/camswap/models
landmarker_model=face_landmarker.task
swap_model=inswapper_512_live_int8.onnx
emap_file=emap.bin
identity=/data/adb/modules/camswap/system/etc/camswap/identities/default.bin
